/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# словарные шарды меняются только при обновлении данных: сутки свежие, неделю можно отдавать старые
/data/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# безопасность — на всех ответах статики (у /api/* свои, в worker/index.js). Полный CSP со script-src не ставим:
# скрипты в страницах inline и после минификации в CI меняются, а 'unsafe-inline' его обессмысливает.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# старый адрес Worker'а отдаёт тот же сайт без Worker'а (редирект на hanzi.lipu.dev стоил бы вызова на каждый запрос):
# убираем его из поиска; canonical на страницах и так указывает на hanzi.lipu.dev
https://hanzi-burst.komapc.workers.dev/*
  X-Robots-Tag: noindex
